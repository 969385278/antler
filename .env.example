# 复制为 .env 并填写（.env 不会被提交到 Git）。使用前：set -a; source .env; set +a
# 评委：任意 OpenAI 兼容接口
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_API_KEY=sk-xxx
JUDGE_MODEL=deepseek-flash
# 评委必须是非思考模式。DeepSeek 会自动加 {"thinking":{"type":"disabled"}}；其他厂商按需设置：
# JUDGE_EXTRA_BODY={"thinking":{"type":"disabled"}}
# JUDGE_MAX_TOKENS=16

# HuggingFace 只读 token（下载 TRAIT 用）
HF_TOKEN=hf_xxx
HF_ENDPOINT=https://hf-mirror.com
